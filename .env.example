# eBay Developers Program application keys (production).
# Create them at https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id
# production or sandbox
EBAY_ENVIRONMENT=production

# Telegram bot created via @BotFather, and the chat that should receive alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where you are willing to receive items. Used as the eBay deliveryCountry filter.
SHIP_TO_COUNTRY=IT
# Optional: improves ship-eligibility accuracy in some cases.
DELIVERY_POSTAL_CODE=

# Start with shadow mode: candidates are found and logged, no Telegram messages are sent.
SHADOW_MODE=true

# Daily 09:00 Telegram digest (top candidates, alert health, review precision).
# Set DIGEST_ENABLED=false to stop it. Times are in the TZ below.
DIGEST_ENABLED=true
DIGEST_HOUR=9
DIGEST_TOP=5

# The dashboard container pings Telegram if the scanner heartbeat goes stale
# (hung loop or dead container) and reports when scanning resumes.
WATCHDOG_ENABLED=true

# Absolute daily cap for Browse/Taxonomy calls. Cannot exceed your eBay allowance.
DAILY_CALL_BUDGET=4000

DATABASE_PATH=/app/data/scanner.db
CONFIG_DIR=/app/config
LOG_LEVEL=INFO
TZ=Europe/Rome

# Local web dashboard (docker compose bridge port / python -m src.main gui).
GUI_BIND=127.0.0.1
GUI_PORT=8080
